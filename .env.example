# =============================================================================
# Confluence — AI Chat Platform (v2.0) · environment variables
#
# Copy to `.env.local` and fill in the values. With **no** Supabase variables
# present the app boots into DEMO MODE (in-browser store + simulated
# streaming assistant). Add the keys below to switch to the real backend.
# =============================================================================

# --- Frontend (client-safe, public) ------------------------------------------
# Public Supabase project URL and anon key. These are safe to expose (see the
# Supabase dashboard → Project Settings → API for the anon/public key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI Model Providers (server-side, add to .env.local) ---------------------
#
# 1. Google Gemini (100% Free, no credit card needed):
#    Get key at: https://aistudio.google.com/app/apikey
#    GEMINI_API_KEY=
#    GEMINI_MODEL=gemini-2.0-flash
#
# 2. DeepSeek API (requires account balance: https://platform.deepseek.com/top_up):
#    DEEPSEEK_API_KEY=
#    DEEPSEEK_MODEL=deepseek-chat
#
# 3. Groq (Free high-speed Llama 3.3 70B: https://console.groq.com):
#    GROQ_API_KEY=
#
# 4. OpenRouter API:
#    OPENROUTER_API_KEY=
#
# 5. OpenAI API:
#    OPENAI_API_KEY=
#
# AI_MODEL — optional global model override
